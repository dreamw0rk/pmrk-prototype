        <!-- ===== Legend ===== -->
        <mxCell id="legend" value="&lt;b&gt;Условные обозначения&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#A9691F&quot;&gt;―――▶&lt;/font&gt; uid — тот же контрагент (эндпойнт 1 → эндпойнты 2-5)&lt;br&gt;&lt;font color=&quot;#57625C&quot;&gt;―――▶&lt;/font&gt; состав ответа (корневой БО → вложенный массив)&lt;br&gt;&lt;font color=&quot;#999999&quot;&gt;- - -▶&lt;/font&gt; ссылка на справочник (вне контура эндпойнтов)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#C4CBC1;fontSize=11;spacing=8;" vertex="1" parent="1">
