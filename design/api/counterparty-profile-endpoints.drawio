  <diagram name="Профиль контрагента — эндпойнты" id="cp-profile-endpoints">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== Title ===== -->
        <mxCell id="title1" value="Профиль контрагента — эндпойнты вкладки «Общие сведения»" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#12294D;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="820" height="26" as="geometry" />
        </mxCell>
        <mxCell id="title2" value="Схема строится от GET /counterparties/{uid}/profile/general — 8 эндпойнтов, каждый вызывается с тем же uid" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#57625C;" vertex="1" parent="1">
          <mxGeometry x="40" y="42" width="820" height="20" as="geometry" />
        </mxCell>

        <!-- ===== Legend ===== -->
        <mxCell id="legend" value="&lt;b&gt;Условные обозначения&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#A9691F&quot;&gt;―――▶&lt;/font&gt; uid — тот же контрагент, единственный ключ ответа&lt;br&gt;&lt;font color=&quot;#5B7A9A&quot;&gt;- - -▶&lt;/font&gt; тот же контрагент, но только через параметр пути (справочник, uid в теле не нужен)&lt;br&gt;&lt;font color=&quot;#57625C&quot;&gt;―――▶&lt;/font&gt; состав ответа (корневой БО → вложенный массив)&lt;br&gt;&lt;font color=&quot;#999999&quot;&gt;- - -▶&lt;/font&gt; ссылка на справочник вне контура эндпойнтов" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#C4CBC1;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1140" y="16" width="400" height="110" as="geometry" />
        </mxCell>

        <!-- ===== Endpoint 1 (hub) ===== -->
