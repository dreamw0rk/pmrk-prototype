        <mxCell id="e1bo1" value="&lt;b&gt;PMRK-ID.BO.19.1&lt;/b&gt;&lt;br&gt;&lt;i&gt;Организация — «Общие сведения»&lt;/i&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;b&gt;uid&lt;/b&gt; — PK, uuid&lt;br&gt;&lt;b&gt;inn&lt;/b&gt; — UN_1, string&lt;br&gt;+ 17 полей (name, kpp, ogrn, registered, region, address, okopf, ownershipForm, website, director, companySize, employees, taxRegime, okvedCode, okved, activityKind, updatedAt)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#1D3E72;strokeWidth=2;fontSize=11;spacing=6;" vertex="1" parent="ep1">
