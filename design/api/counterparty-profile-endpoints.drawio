        <!-- ===== Title ===== -->
        <mxCell id="title1" value="Профиль контрагента — эндпойнты вкладки «Общие сведения»" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#12294D;" vertex="1" parent="1">
