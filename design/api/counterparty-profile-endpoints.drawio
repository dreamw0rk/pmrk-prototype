        </mxCell>
        <mxCell id="title2" value="Схема строится от GET /counterparties/{uid}/profile/general — остальные эндпойнты вызываются с тем же uid" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#57625C;" vertex="1" parent="1">
